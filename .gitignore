# --- Secrets: never commit ---
.env
*.pem
*.key

# --- Personal data: resumes, DB, screenshots, cookies, uploads ---
# data/ is the runtime dir (DB, credentials, resumes, exports) — ignore its
# contents, but track the pipeline scripts (data/*.py) so the project runs
# from any machine. Credential/DB/output files in data/ stay ignored.
data/*
!data/*.py
*.db
*.sqlite3
resumes/
uploads/
cookies/
sessions/
screenshots/

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# --- OS / editor ---
.DS_Store
Thumbs.db
.vscode/
.idea/

# --- Logs (action logs are stored in DB, not files) ---
*.log
logs/

# third-party repos (cloned, not tracked)
third_party/
graphify-out/
chrome_hwnd.txt
