# Copy to .env and fill in real values. NEVER commit .env.

# --- LLM provider (swappable interface) ---
# One of: openai | openrouter | anthropic | ollama
LLM_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
# Default model. For LLM_PROVIDER=openrouter use a full OpenRouter model id
# (e.g. openai/gpt-4o-mini, anthropic/claude-3.5-sonnet, google/gemini-flash-1.5).
# A plain name (gpt-4o-mini) is auto-prefixed with openai/ for OpenRouter.
LLM_MODEL=gpt-4o-mini

# --- OpenRouter (https://openrouter.ai/keys) ---
# Set LLM_PROVIDER=openrouter + this key to route through OpenRouter.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- App ---
HOST=127.0.0.1
PORT=8000
DATABASE_URL=sqlite:///./data/jobflow.db

# --- Pipeline / automation ---
# DRY_RUN=true (default): fill forms + screenshot, NEVER submit.
DRY_RUN=true
# Auto-submit only enabled when DRY_RUN=false AND match score >= this.
MIN_MATCH_SCORE=70

# --- Polite scraping ---
REQUEST_DELAY_SECONDS=2
USER_AGENT=Mozilla/5.0 (jobflow-local-automation)
